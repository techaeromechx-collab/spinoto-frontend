{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the Spinoto CRM window is allowed to reach on the user's machine. Deliberately short \u2014 see src-tauri/src/lib.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "fs:allow-write-file",
    "fs:allow-temp-write-recursive",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
